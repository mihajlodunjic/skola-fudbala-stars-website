---
import ActionLink from "../components/common/ActionLink.astro";
import ContactBand from "../components/common/ContactBand.astro";
import LogoMark from "../components/common/LogoMark.astro";
import SectionLabel from "../components/common/SectionLabel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { business, contactLinks } from "../data/business";
import { activityRows, developmentRows } from "../data/principles";
import { pageSeo } from "../data/seo";
import { siteCopy } from "../data/site-copy";
---

<BaseLayout seo={pageSeo.home} includeOrganizationSchema>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container grid home-hero__grid">
      <div class="home-hero__copy">
        <SectionLabel text={siteCopy.home.hero.metadata} />
        <h1 id="home-title">
          <span>Fudbal, druženje i</span>
          <span>dobre navike</span>
          <span>od prvog treninga</span>
        </h1>
        <p class="lead">{siteCopy.home.hero.intro}</p>
        <div class="action-row">
          <ActionLink href={contactLinks.phone} label={siteCopy.home.hero.primaryCta} variant="yellow" />
          <ActionLink href="/rad-sa-decom/" label={siteCopy.home.hero.secondaryCta} variant="outline" />
        </div>
        <p class="hero-note">{business.phone.display}</p>
      </div>
      <div class="home-hero__visual">
        <div class="hero-rings" aria-hidden="true">
          <LogoMark variant="hero" loading="eager" />
        </div>
      </div>
      <p class="home-hero__vertical" aria-hidden="true">{siteCopy.home.hero.metadata}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="development-title">
    <div class="container">
      <div class="split-heading">
        <SectionLabel text={siteCopy.home.development.metadata} />
        <div>
          <h2 id="development-title">{siteCopy.home.development.h2}</h2>
          <p class="lead">{siteCopy.home.development.intro}</p>
        </div>
      </div>
      <div class="numbered-rows">
        {
          developmentRows.map((row) => (
            <article class="numbered-row">
              <span class="numbered-row__number">{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.text}</p>
            </article>
          ))
        }
      </div>
      <div class="action-row" style="margin-top: var(--space-8);">
        <ActionLink href="/rad-sa-decom/" label={siteCopy.home.development.cta} variant="blue" />
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="editorial-title">
    <div class="container grid editorial-grid">
      <div class="editorial-copy">
        <SectionLabel text={siteCopy.home.editorial.metadata} />
        <h2 id="editorial-title">{siteCopy.home.editorial.h2}</h2>
        <p class="lead">{siteCopy.home.editorial.text}</p>
        <ActionLink href="/rad-sa-decom/" label={siteCopy.home.editorial.link} variant="text" />
      </div>
      <div
        class="training-board"
        data-tactical-board
        role="img"
        aria-label="Stilizovana taktička vežba: četiri igrača prate igru, sarađuju, preuzimaju zadatak i završavaju akciju kao tim."
      >
        <div class="training-board__field" aria-hidden="true">
          <div class="training-board__label">VEŽBA 02 · TIMSKA AKCIJA</div>
          <svg class="training-board__pitch" viewBox="0 0 720 540" focusable="false">
            <defs>
              <marker id="route-arrow-blue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L8 4 L0 8 Z" class="route-arrow route-arrow--blue"></path>
              </marker>
              <marker id="route-arrow-yellow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L8 4 L0 8 Z" class="route-arrow route-arrow--yellow"></path>
              </marker>
            </defs>
            <rect class="pitch-line pitch-line--draw" x="28" y="34" width="664" height="472" rx="10" pathLength="1"></rect>
            <line class="pitch-line pitch-line--draw pitch-line--muted" x1="360" y1="34" x2="360" y2="506" pathLength="1"></line>
            <circle class="pitch-line pitch-line--draw pitch-line--muted" cx="360" cy="270" r="74" pathLength="1"></circle>
            <rect class="pitch-line pitch-line--draw" x="28" y="174" width="116" height="192" rx="0" pathLength="1"></rect>
            <rect class="pitch-line pitch-line--draw" x="576" y="174" width="116" height="192" rx="0" pathLength="1"></rect>
            <rect class="free-space" x="492" y="198" width="124" height="98" rx="6"></rect>
            <path class="route route-pass-one" d="M144 346 C204 318 246 292 302 276" pathLength="1" marker-end="url(#route-arrow-yellow)"></path>
            <path class="route route-run-three" d="M440 346 C474 318 500 278 526 254" pathLength="1" marker-end="url(#route-arrow-blue)"></path>
            <path class="route route-pass-two" d="M302 276 C376 255 452 246 526 254" pathLength="1" marker-end="url(#route-arrow-yellow)"></path>
            <path class="team-link team-link--one" d="M166 334 L318 296 L526 254 L354 410 Z" pathLength="1"></path>
            <path class="team-link team-link--two" d="M166 334 L354 410 M318 296 L354 410" pathLength="1"></path>
          </svg>
          <span class="tactical-player tactical-player--01"><span>01</span></span>
          <span class="tactical-player tactical-player--02"><span>02</span></span>
          <span class="tactical-player tactical-player--03"><span>03</span></span>
          <span class="tactical-player tactical-player--04"><span>04</span></span>
          <span class="tactical-ball"></span>
        </div>
        <ol class="training-board__status" aria-hidden="true">
          <li>PRATI IGRU</li>
          <li>SARAĐUJE</li>
          <li>PREUZIMA ZADATAK</li>
          <li>IGRA KAO DEO TIMA</li>
        </ol>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const boards = document.querySelectorAll("[data-tactical-board]");
      if (!boards.length) return;

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (reduceMotion.matches) {
        boards.forEach((board) => board.classList.add("is-final"));
        return;
      }

      if (!("IntersectionObserver" in window)) {
        boards.forEach((board) => board.classList.add("is-running"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle("is-running", entry.isIntersecting);
          });
        },
        { threshold: 0.32, rootMargin: "0px 0px -8% 0px" },
      );

      boards.forEach((board) => observer.observe(board));
    })();
  </script>

  <section class="section section--white" aria-labelledby="groups-title">
    <div class="container">
      <div class="club-note">
        <div>
          <SectionLabel text={siteCopy.home.groups.metadata} />
          <div class="star-cluster" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        <div>
          <h2 id="groups-title">{siteCopy.home.groups.h2}</h2>
          <p class="lead">{siteCopy.home.groups.text}</p>
          <div class="action-row" style="margin-top: var(--space-6);">
            <ActionLink href="/kontakt/" label={siteCopy.home.groups.cta} variant="blue" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="location-band section" aria-labelledby="locations-title">
    <div class="container location-band__content">
      <div>
        <SectionLabel text={siteCopy.home.locations.metadata} />
        <h2 id="locations-title">{siteCopy.home.locations.h2}</h2>
        <p class="lead">{siteCopy.home.locations.text}</p>
      </div>
      <div class="contact-band__actions">
        <ActionLink href="/kontakt/" label={siteCopy.home.locations.primaryCta} variant="blue" />
        <ActionLink href="/lokacije/" label={siteCopy.home.locations.secondaryLink} variant="text" />
        <span class="hero-note">{business.phone.display}</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="continuity-title">
    <div class="container grid year-section">
      <div style="grid-column: 1 / -1;">
        <SectionLabel text={siteCopy.home.continuity.metadata} />
      </div>
      <div class="year-number" aria-hidden="true">{siteCopy.home.continuity.visual}</div>
      <div class="text-measure">
        <h2 id="continuity-title">{siteCopy.home.continuity.h2}</h2>
        <p class="lead">{siteCopy.home.continuity.text}</p>
        <div class="action-row" style="margin-top: var(--space-6);">
          <ActionLink href="/o-skoli/" label={siteCopy.home.continuity.cta} variant="blue" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="activities-title">
    <div class="container">
      <div class="split-heading">
        <SectionLabel text={siteCopy.home.activities.metadata} />
        <div>
          <h2 id="activities-title">{siteCopy.home.activities.h2}</h2>
          <p class="lead">{siteCopy.home.activities.intro}</p>
        </div>
      </div>
      <div class="activity-list">
        {
          activityRows.map((item, index) => (
            <div class="activity-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">{siteCopy.home.activities.note}</p>
    </div>
  </section>

  <ContactBand />
</BaseLayout>
