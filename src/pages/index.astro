---
import ActionLink from "../components/common/ActionLink.astro";
import ContactBand from "../components/common/ContactBand.astro";
import LogoMark from "../components/common/LogoMark.astro";
import SectionLabel from "../components/common/SectionLabel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { business, contactLinks } from "../data/business";
import { activityRows, developmentRows } from "../data/principles";
import { pageSeo } from "../data/seo";
import { siteCopy } from "../data/site-copy";
---

<BaseLayout seo={pageSeo.home} includeOrganizationSchema>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container grid home-hero__grid">
      <div class="home-hero__copy">
        <SectionLabel text={siteCopy.home.hero.metadata} />
        <h1 id="home-title">
          <span>Fudbal, druženje i</span>
          <span>dobre navike</span>
          <span>od prvog treninga</span>
        </h1>
        <p class="lead">{siteCopy.home.hero.intro}</p>
        <div class="action-row">
          <ActionLink href={contactLinks.phone} label={siteCopy.home.hero.primaryCta} variant="yellow" />
          <ActionLink href="/rad-sa-decom/" label={siteCopy.home.hero.secondaryCta} variant="outline" />
        </div>
        <p class="hero-note">{business.phone.display}</p>
      </div>
      <div class="home-hero__visual">
        <div class="hero-rings" aria-hidden="true">
          <LogoMark variant="hero" loading="eager" />
        </div>
      </div>
      <p class="home-hero__vertical" aria-hidden="true">{siteCopy.home.hero.metadata}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="development-title">
    <div class="container">
      <div class="split-heading">
        <SectionLabel text={siteCopy.home.development.metadata} />
        <div>
          <h2 id="development-title">{siteCopy.home.development.h2}</h2>
          <p class="lead">{siteCopy.home.development.intro}</p>
        </div>
      </div>
      <div class="numbered-rows">
        {
          developmentRows.map((row) => (
            <article class="numbered-row">
              <span class="numbered-row__number">{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.text}</p>
            </article>
          ))
        }
      </div>
      <div class="action-row" style="margin-top: var(--space-8);">
        <ActionLink href="/rad-sa-decom/" label={siteCopy.home.development.cta} variant="blue" />
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="editorial-title">
    <div class="container grid editorial-grid">
      <div class="editorial-copy">
        <SectionLabel text={siteCopy.home.editorial.metadata} />
        <h2 id="editorial-title">{siteCopy.home.editorial.h2}</h2>
        <p class="lead">{siteCopy.home.editorial.text}</p>
        <ActionLink href="/rad-sa-decom/" label={siteCopy.home.editorial.link} variant="text" />
      </div>
      <div
        class="training-board"
        data-tactical-board
        role="img"
        aria-label="Stilizovana taktička vežba: četiri igrača prate igru, sarađuju, preuzimaju zadatak i završavaju akciju kao tim."
      >
        <div class="training-board__field" aria-hidden="true">
          <svg
            class="training-board__pitch"
            viewBox="0 0 720 540"
            preserveAspectRatio="xMidYMid meet"
            focusable="false"
          >
            <defs>
              <marker id="route-arrow-blue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L8 4 L0 8 Z" class="route-arrow route-arrow--blue"></path>
              </marker>
              <marker id="route-arrow-yellow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L8 4 L0 8 Z" class="route-arrow route-arrow--yellow"></path>
              </marker>
            </defs>
            <rect class="pitch-background" x="0" y="0" width="720" height="540" rx="0"></rect>

            <g class="pitch-layer">
              <rect class="pitch-line pitch-line--draw pitch-line--outer" x="28" y="34" width="664" height="472" rx="10"></rect>
              <line class="pitch-line pitch-line--draw pitch-line--muted pitch-line--straight" x1="360" y1="34" x2="360" y2="506"></line>
              <circle class="pitch-line pitch-line--draw pitch-line--muted pitch-line--circle" cx="360" cy="270" r="74"></circle>
              <rect class="pitch-line pitch-line--draw pitch-line--box" x="28" y="174" width="116" height="192" rx="0"></rect>
              <rect class="pitch-line pitch-line--draw pitch-line--box" x="576" y="174" width="116" height="192" rx="0"></rect>
              <rect class="free-space" x="492" y="198" width="124" height="98" rx="6"></rect>
            </g>

            <g class="route-layer">
              <path class="route route-pass-one" d="M144 346 C204 318 246 292 302 276" marker-end="url(#route-arrow-yellow)"></path>
              <path class="route route-run-three" d="M440 346 C474 318 500 278 526 254" marker-end="url(#route-arrow-blue)"></path>
              <path class="route route-pass-two" d="M302 276 C382 253 470 242 558 238" marker-end="url(#route-arrow-yellow)"></path>
            </g>

            <g class="team-layer">
              <path class="team-link team-link--one" d="M166 334 L318 296 L526 254 L354 410 Z"></path>
              <path class="team-link team-link--two" d="M166 334 L354 410 M318 296 L354 410"></path>
            </g>

            <g class="ball-layer">
              <circle class="tactical-ball" cx="558" cy="238" r="10">
                <animate class="tactical-motion" attributeName="cx" values="144;144;302;302;558;558" keyTimes="0;0.2;0.43;0.62;0.82;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animate>
                <animate class="tactical-motion" attributeName="cy" values="346;346;276;276;238;238" keyTimes="0;0.2;0.43;0.62;0.82;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animate>
              </circle>
            </g>

            <g class="player-layer">
              <g class="tactical-player tactical-player--01" transform="translate(166 334)">
                <animateTransform class="tactical-motion" attributeName="transform" type="translate" values="144 346;144 346;166 334;166 334;166 334" keyTimes="0;0.52;0.72;0.9;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animateTransform>
                <g class="player-core">
                  <circle r="22"></circle>
                  <text y="1">01</text>
                </g>
              </g>
              <g class="tactical-player tactical-player--02" transform="translate(318 296)">
                <animateTransform class="tactical-motion" attributeName="transform" type="translate" values="302 276;302 276;318 296;318 296" keyTimes="0;0.54;0.72;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animateTransform>
                <g class="player-core">
                  <circle r="22"></circle>
                  <text y="1">02</text>
                </g>
              </g>
              <g class="tactical-player tactical-player--03" transform="translate(526 254)">
                <animateTransform class="tactical-motion" attributeName="transform" type="translate" values="440 346;440 346;526 254;526 254" keyTimes="0;0.55;0.78;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animateTransform>
                <g class="player-core">
                  <circle r="22"></circle>
                  <text y="1">03</text>
                </g>
              </g>
              <g class="tactical-player tactical-player--04" transform="translate(354 410)">
                <animateTransform class="tactical-motion" attributeName="transform" type="translate" values="354 410;354 410;372 396;354 410;354 410" keyTimes="0;0.54;0.7;0.86;1" dur="7.8s" repeatCount="indefinite" begin="indefinite"></animateTransform>
                <g class="player-core">
                  <circle r="22"></circle>
                  <text y="1">04</text>
                </g>
              </g>
            </g>

            <g class="ring-layer">
              <circle class="active-ring active-ring--watch" cx="302" cy="276" r="31"></circle>
              <circle class="active-ring active-ring--task" cx="526" cy="254" r="31"></circle>
            </g>

            <g class="board-label">
              <rect x="48" y="28" width="186" height="38" rx="0"></rect>
              <text x="64" y="53">VEŽBA 02 · TIMSKA AKCIJA</text>
            </g>
          </svg>
        </div>
        <ol class="training-board__status" aria-hidden="true">
          <li>PRATI IGRU</li>
          <li>SARAĐUJE</li>
          <li>PREUZIMA ZADATAK</li>
          <li>IGRA KAO DEO TIMA</li>
        </ol>
      </div>
    </div>
  </section>

  <script is:inline>
  (() => {
    try {
    const boards = Array.from(document.querySelectorAll("[data-tactical-board]"));
    if (!boards.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const startRatio = 0.1;
    const states = new WeakMap();

    const getState = (board) => {
      if (!states.has(board)) {
        states.set(board, { running: false, starting: false, token: 0, raf: 0 });
      }

      return states.get(board);
    };

    const getViewport = () => ({
      width: Math.max(window.innerWidth || 0, window.visualViewport?.width || 0),
      height: Math.max(window.innerHeight || 0, window.visualViewport?.height || 0),
    });

    const getMetrics = (board) => {
      const rect = board.getBoundingClientRect();
      const viewport = getViewport();
      const visibleWidth = Math.max(0, Math.min(rect.right, viewport.width) - Math.max(rect.left, 0));
      const visibleHeight = Math.max(0, Math.min(rect.bottom, viewport.height) - Math.max(rect.top, 0));
      const area = Math.max(1, rect.width * rect.height);

      return {
        ratio: (visibleWidth * visibleHeight) / area,
        out: rect.bottom <= 0 || rect.top >= viewport.height || rect.right <= 0 || rect.left >= viewport.width,
      };
    };

    const frameTwice = () =>
      new Promise((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(resolve));
      });

    const getSvg = (board) => board.querySelector(".training-board__pitch");
    const getMotion = (board) => Array.from(board.querySelectorAll(".tactical-motion"));

    const endSvgMotion = (board) => {
      getMotion(board).forEach((motion) => {
        try {
          motion.endElement();
        } catch {
          /* SVG animation may not have started yet. */
        }
      });
    };

    const pauseSvgMotion = (board) => {
      try {
        getSvg(board)?.pauseAnimations();
      } catch {
        /* Some browsers expose SVG animation controls partially. */
      }
    };

    const startSvgMotion = (board) => {
      const svg = getSvg(board);

      try {
        svg?.setCurrentTime(0);
      } catch {
        /* Keep CSS animation fallback if SVG timeline cannot be reset. */
      }

      getMotion(board).forEach((motion) => {
        try {
          motion.beginElement();
        } catch {
          /* Static final state remains visible if SVG animation is unavailable. */
        }
      });

      try {
        svg?.unpauseAnimations();
      } catch {
        /* Static final state remains visible if SVG animation is unavailable. */
      }
    };

    const resetBoard = (board) => {
      const state = getState(board);
      state.token += 1;
      state.running = false;
      state.starting = false;
      board.classList.remove("is-running", "is-animated");
      endSvgMotion(board);
      pauseSvgMotion(board);
    };

    const suspendBoard = (board) => {
      const state = getState(board);
      state.token += 1;
      state.running = false;
      state.starting = false;
      board.classList.remove("is-running");
      pauseSvgMotion(board);
    };

    const startBoard = async (board, restart = false) => {
      const state = getState(board);
      if (state.starting || (state.running && !restart)) return;

      state.token += 1;
      const token = state.token;
      state.starting = true;
      state.running = false;

      endSvgMotion(board);
      board.classList.add("is-animated");
      board.classList.remove("is-running");

      await frameTwice();

      const metrics = getMetrics(board);
      if (state.token !== token || document.visibilityState === "hidden" || metrics.out || metrics.ratio < startRatio) {
        state.starting = false;
        return;
      }

      startSvgMotion(board);
      board.classList.add("is-running");
      state.running = true;
      state.starting = false;
    };

    const syncBoard = (board, restart = false) => {
      if (reduceMotion.matches) {
        resetBoard(board);
        return;
      }

      const metrics = getMetrics(board);
      const state = getState(board);

      if (metrics.out) {
        if (state.running || state.starting || board.classList.contains("is-animated")) resetBoard(board);
        return;
      }

      if (metrics.ratio >= startRatio) {
        startBoard(board, restart);
      }
    };

    const queueSync = (board, restart = false) => {
      const state = getState(board);
      if (state.raf) cancelAnimationFrame(state.raf);
      state.raf = requestAnimationFrame(() => {
        state.raf = 0;
        syncBoard(board, restart);
      });
    };

    const syncAll = (restart = false) => boards.forEach((board) => queueSync(board, restart));

    boards.forEach((board) => resetBoard(board));

    if (reduceMotion.matches) return;

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= startRatio) {
              startBoard(entry.target);
              return;
            }

            queueSync(entry.target);
          });
        },
        { threshold: [0, startRatio], rootMargin: "0px" },
      );

      boards.forEach((board) => observer.observe(board));
    } else {
      window.addEventListener("scroll", () => syncAll(), { passive: true });
      window.addEventListener("resize", () => syncAll(), { passive: true });
    }

    window.visualViewport?.addEventListener("resize", () => syncAll(), { passive: true });
    window.visualViewport?.addEventListener("scroll", () => syncAll(), { passive: true });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        boards.forEach((board) => suspendBoard(board));
        return;
      }

      syncAll(true);
    });

    window.addEventListener("pageshow", (event) => {
      syncAll(Boolean(event.persisted));
    });

    reduceMotion.addEventListener?.("change", (event) => {
      if (event.matches) {
        boards.forEach((board) => resetBoard(board));
        return;
      }

      syncAll(true);
    });

    window.addEventListener("load", () => {
      syncAll();
    });

    syncAll();
    } catch {
      document.querySelectorAll("[data-tactical-board]").forEach((board) => {
        board.classList.remove("is-running", "is-animated");
      });
    }
  })();
  </script>

  <section class="section section--white" aria-labelledby="groups-title">
    <div class="container">
      <div class="club-note">
        <div>
          <SectionLabel text={siteCopy.home.groups.metadata} />
          <div class="star-cluster" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        <div>
          <h2 id="groups-title">{siteCopy.home.groups.h2}</h2>
          <p class="lead">{siteCopy.home.groups.text}</p>
          <div class="action-row" style="margin-top: var(--space-6);">
            <ActionLink href="/kontakt/" label={siteCopy.home.groups.cta} variant="blue" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="location-band section" aria-labelledby="locations-title">
    <div class="container location-band__content">
      <div>
        <SectionLabel text={siteCopy.home.locations.metadata} />
        <h2 id="locations-title">{siteCopy.home.locations.h2}</h2>
        <p class="lead">{siteCopy.home.locations.text}</p>
      </div>
      <div class="contact-band__actions">
        <ActionLink href="/kontakt/" label={siteCopy.home.locations.primaryCta} variant="blue" />
        <ActionLink href="/lokacije/" label={siteCopy.home.locations.secondaryLink} variant="text" />
        <span class="hero-note">{business.phone.display}</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="continuity-title">
    <div class="container grid year-section">
      <div style="grid-column: 1 / -1;">
        <SectionLabel text={siteCopy.home.continuity.metadata} />
      </div>
      <div class="year-number" aria-hidden="true">{siteCopy.home.continuity.visual}</div>
      <div class="text-measure">
        <h2 id="continuity-title">{siteCopy.home.continuity.h2}</h2>
        <p class="lead">{siteCopy.home.continuity.text}</p>
        <div class="action-row" style="margin-top: var(--space-6);">
          <ActionLink href="/o-skoli/" label={siteCopy.home.continuity.cta} variant="blue" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="activities-title">
    <div class="container">
      <div class="split-heading">
        <SectionLabel text={siteCopy.home.activities.metadata} />
        <div>
          <h2 id="activities-title">{siteCopy.home.activities.h2}</h2>
          <p class="lead">{siteCopy.home.activities.intro}</p>
        </div>
      </div>
      <div class="activity-list">
        {
          activityRows.map((item, index) => (
            <div class="activity-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">{siteCopy.home.activities.note}</p>
    </div>
  </section>

  <ContactBand />
</BaseLayout>
